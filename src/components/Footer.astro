---
import Logo from './Logo.astro';
import { nav, site, whatsappLink } from '../lib/site';

interface Props { waMessage?: string }
const { waMessage = 'Hello IQUE Green India, I would like to book a site visit.' } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="ftr-top wrap">
    <div>
      <Logo descriptor={false} />
      <p class="ftr-tag">{site.tagline}.</p>
    </div>
    <div class="ftr-col">
      <h2 class="mono">Explore</h2>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/book/">Book a site visit</a>
    </div>
    <div class="ftr-col">
      <h2 class="mono">Reach us</h2>
      <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
      <a href={`tel:${site.landline}`}>{site.landlineDisplay}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={whatsappLink(waMessage)} target="_blank" rel="noopener">WhatsApp</a>
    </div>
    <div class="ftr-col">
      <h2 class="mono">Corporate office</h2>
      <address>B-1227, Indira Nagar<br />Lucknow 226016<br />Uttar Pradesh, India</address>
    </div>
  </div>
  <div class="ftr-word" aria-hidden="true">IQUE Green India</div>
  <div class="ftr-base wrap mono">
    <span>© {year} {site.legalName}</span>
    <span>CIN {site.cin}</span>
  </div>
</footer>

<a class="wa-float" href={whatsappLink(waMessage)} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.8 14.1c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.5c-.2.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
</a>

<div class="dock">
  <a href={`tel:${site.phone}`}>Call</a>
  <a class="dock-wa" href={whatsappLink(waMessage)} target="_blank" rel="noopener">WhatsApp</a>
  <a href="/book/">Book</a>
</div>
